# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Логин и пароль для входа в бота: /login <логин> <пароль>
# Карточки получают все вошедшие чаты. Смена значений разлогинивает всех.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-please

# --- Instagram (Instagram API with Instagram Login) ---
# Long-lived токен. Используется только как начальное значение, пока в БД пусто;
# дальше сервис сам обновляет токен и хранит его в таблице settings.
IG_ACCESS_TOKEN=IGAA...
# ID профессионального аккаунта (поле user_id из GET /me?fields=user_id,username)
IG_USER_ID=17841400000000000

# Нужны только для MODE=webhook
# Instagram App Secret: App Dashboard → Instagram → API setup with Instagram login
META_APP_SECRET=
# Любая случайная строка; та же указывается в настройках вебхука в App Dashboard
META_VERIFY_TOKEN=

# --- Сервис ---
# Локально: ./data/app.db, на Railway: /data/app.db (Volume с mount path /data)
DB_PATH=./data/app.db
# polling | webhook
MODE=polling
POLL_INTERVAL_SEC=120
PORT=3000
